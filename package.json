{
  "name": "aide",
  "version": "0.1.0",
  "private": true,
  "description": "A custom IDE built for multi-agent workflows",
  "author": "Cheezeiii365",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"packages/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit -p packages/main/tsconfig.json && tsc --noEmit -p packages/renderer/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:ci": "pnpm typecheck && pnpm test && pnpm test:e2e",
    "dist": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:publish": "electron-vite build && electron-builder --mac --publish always"
  },
  "main": "packages/main/dist/index.js",
  "devDependencies": {
    "@anthropic-ai/claude-code": "*",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^41.0.0",
    "electron-builder": "^25.0.0",
    "electron-playwright-helpers": "^1.7.0",
    "electron-vite": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ]
  }
}
