{
  "name": "aide",
  "version": "0.1.0",
  "private": true,
  "description": "A custom IDE built for multi-agent workflows",
  "author": "Cheezeiii365",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:clean": "electron-vite dev -- --clean",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"packages/**/*.{ts,tsx,css,json}\"",
    "build:shared": "pnpm --filter @aide/shared build",
    "typecheck": "tsc -b packages/shared packages/main packages/renderer",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:ci": "pnpm typecheck && pnpm test && pnpm test:e2e",
    "dist": "electron-vite build && electron-builder --mac",
    "dist:local": "electron-vite build && electron-builder --mac --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:publish": "electron-vite build && electron-builder --mac --publish always",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "main": "packages/main/dist/index.js",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.91",
    "@anthropic-ai/claude-code": "*",
    "@opencode-ai/sdk": "^1.4.0",
    "@vscode/ripgrep": "^1.17.1",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^41.0.0",
    "electron-builder": "^25.0.0",
    "electron-playwright-helpers": "^1.7.0",
    "electron-vite": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@vscode/ripgrep",
      "electron",
      "esbuild",
      "node-pty"
    ]
  }
}
